# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# --- LLM: set ONE of these. Without any, the app runs in search-only mode. ---
# DeepSeek (default model deepseek-flash). Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenRouter, any model it hosts (default deepseek/deepseek-v4.1-flash;
# AGENT_MODEL=openrouter/free routes to a free model). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Claude via the Anthropic API (default model claude-opus-5-5)
ANTHROPIC_API_KEY=
# Any other OpenAI-compatible API: set LLM_PROVIDER=openai-compatible,
# LLM_BASE_URL, LLM_API_KEY and AGENT_MODEL.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=

# Optional tuning
AGENT_MODEL=
# low | medium | high | max (Claude effort / DeepSeek reasoning_effort)
AGENT_EFFORT=medium
# DeepSeek thinking mode: enabled | disabled
LLM_THINKING=enabled
# Claude only: server-side refusal fallbacks (a request declined by a safety
# classifier is retried on the model Anthropic recommends for that category).
AGENT_FALLBACKS=true

# Optional: data.egov.kz API key, enables the preview_rows tool
EGOV_API_KEY=

# Local infrastructure
POSTGRES_PASSWORD=egov
CHAT_RATE_PER_MIN=10
# Cap on chat questions per UTC day across all visitors (0 = unlimited).
# Set it on a public demo so the LLM bill stays bounded.
CHAT_DAILY_LIMIT=0
