# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Enables the AI agent. Without it the app runs in search-only mode.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Agent tuning (defaults shown)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# Server-side refusal fallbacks: a request declined by a safety classifier is
# retried on the model Anthropic recommends for that category.
AGENT_FALLBACKS=true

# Optional: data.egov.kz API key, enables the preview_rows tool
EGOV_API_KEY=

# Local infrastructure
POSTGRES_PASSWORD=egov
CHAT_RATE_PER_MIN=10
# Cap on chat questions per UTC day across all visitors (0 = unlimited).
# Set it on a public demo so the Anthropic bill stays bounded.
CHAT_DAILY_LIMIT=0
